# Keep the build context small and secret-free; the image only needs requirements-api.txt, src/, db/.
# models/ is a local download (python -m src.search --download-onnx); the image fetches its own copy.
models/
data/
.venv/
venv/
.git/
.gitignore
.env
.claude/
.vscode/
.idea/
**/__pycache__/
**/*.pyc
.pytest_cache/
.ipynb_checkpoints/
*.npy
*.parquet
tests/
results/
results.md
eval/
